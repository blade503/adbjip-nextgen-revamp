# Configuration Apache pour l'hébergement mutualisé LWS.
#
# Vite recopie public/ dans dist/ : ce fichier part donc avec le build.
# Vérifier après le premier envoi FTP qu'il est bien présent à la racine —
# certains clients FTP masquent ou ignorent les fichiers commençant par un point.
#
# TOUTES LES RÈGLES DE CE FICHIER ONT ÉTÉ ÉPROUVÉES sous Apache 2.4.66 en local,
# avec les modules de LWS (rewrite, alias, deflate, expires, headers, dir) et le
# `dist/` réel. Les valeurs indiquées en commentaire sont des relevés, pas des
# estimations. Reproduire : voir § « Vérification » de REPRISE.md.

RewriteEngine On

# --- HTTPS et domaine canonique ---------------------------------------------
# Une seule adresse indexable : https://www.adbjip.fr
#
# `%{HTTPS}` est fourni par mod_ssl. Sur un mutualisé placé derrière un
# répartiteur, il peut valoir « off » alors que le visiteur est déjà en HTTPS —
# ce qui produit une boucle de redirection infinie. La seconde condition évite
# ce cas : si le répartiteur annonce https, on ne redirige pas.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^adbjip\.fr$ [NC]
RewriteRule ^(.*)$ https://www.adbjip.fr/$1 [L,R=301]

# --- Redirections depuis l'ancien site Symfony ------------------------------
# Les URL de 2017 sont indexées depuis huit ans : elles doivent conduire à la
# page équivalente, pas à une erreur. Piège : /about était la page contact de
# l'ancien site, alors que /about existe aussi dans la refonte avec un tout
# autre contenu — d'où la redirection vers /contact.
#
# Ces quatre lignes emploient `Redirect` (mod_alias) et non `RewriteRule`.
# Vérifié en local : mod_alias agit avant les règles de `.htaccess`, les quatre
# 301 partent donc bien AVANT le repli monopage. Les quatre ont été testées une
# par une, code et destination relevés.
Redirect 301 /gerer-bien /services/gestion-locative
Redirect 301 /gerer-copropriete /services/gestion-copropriete
Redirect 301 /estimation /services/estimation-biens
Redirect 301 /about /contact

# --- Pages prérendues --------------------------------------------------------
# `npm run build` écrit dix pages en HTML statique : dist/index.html et neuf
# dossiers du type dist/biens/index.html.
#
# SANS CE BLOC, mod_dir voyait un dossier et renvoyait une 301 vers la forme
# avec barre oblique finale. Mesuré : les NEUF routes répondaient 301 vers
# `/biens/`, `/contact/`, etc. alors que la balise canonique et le sitemap
# déclarent `/biens` sans barre. Google recevait donc une contradiction, et
# chaque visite directe payait un aller-retour de plus.
#
# `DirectorySlash Off` est sans danger ici parce que `Options -Indexes` est
# posé plus bas : aucun listing de dossier n'est possible.
DirectorySlash Off

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ /$1/index.html [L]

# --- Pas de repli monopage, et c'est un arbitrage daté du 27/08/2026 ---------
#
# Il y avait ici trois lignes qui servaient `index.html` pour TOUT ce qui n'est
# pas un fichier : c'était le filet de l'application monopage. Conséquence : une
# URL inconnue répondait **200** avec la coquille, et React y affichait « Page
# introuvable ». Une « soft 404 » — Google indexe alors des pages d'erreur.
#
# Elles sont retirées. Les dix routes réelles sont servies par le bloc
# précédent, qui trouve `<route>/index.html` produit par `scripts/prerender.mjs`.
# Tout le reste tombe sur l'`ErrorDocument` en bas de ce fichier, avec un vrai
# code 404.
#
# CE QUE CELA REND CRITIQUE, ET IL FAUT LE SAVOIR : sans repli, un prérendu raté
# ne dégrade plus le site — il le CASSE. Si `prerender.mjs` ne produit rien (pas
# de Chrome sur le runner), aucune route n'a de fichier et TOUTES répondent 404.
# Le garde-fou est l'étape « Vérifier la mise en ligne » de
# `.github/workflows/deploy.yml`, qui fait échouer le run si les contrôles ne
# passent pas. **Si cette étape est un jour retirée, remettre les trois lignes.**

# --- Compression -------------------------------------------------------------
# LES DEUX ORTHOGRAPHES DE CHAQUE TYPE SONT NÉCESSAIRES, et c'est un piège coûteux.
# Apache 2.4 sert les .js en `text/javascript` (et non `application/javascript`)
# et les .xml en `application/xml` (et non `text/xml`). La liste précédente ne
# citait que les secondes : mesuré, le bundle partait en 348 953 octets NON
# COMPRESSÉS, et le sitemap aussi.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE text/xml application/xml application/rss+xml
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# --- Cache -------------------------------------------------------------------
# Les fichiers de dist/assets portent une empreinte dans leur nom : ils peuvent
# être mis en cache indéfiniment. index.html, lui, ne doit jamais l'être, sinon
# un visiteur reste bloqué sur une ancienne version après chaque déploiement.
#
# Même piège que pour la compression : `text/javascript` était absent, donc le
# bundle repartait SANS AUCUN en-tête de cache. Mesuré avant correction.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # `immutable` dit au navigateur de ne même pas revalider : c'est exact pour un
  # nom de fichier qui contient une empreinte du contenu.
  <FilesMatch "\.(css|js|webp|jpe?g|png|svg|woff2?|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Sauvegarde des demandes --------------------------------------------------
# contact.php consigne chaque demande dans leads.jsonl à titre de filet : ce
# fichier ne doit jamais être servi. Vérifié : 403.
<Files "leads.jsonl">
  Require all denied
</Files>

# --- Divers ------------------------------------------------------------------
Options -Indexes
AddDefaultCharset UTF-8

# La page 404 prérendue, rendue avec le bon code. Depuis le retrait du repli
# monopage (voir plus haut), c'est le passage OBLIGÉ de toute URL inconnue — et
# non plus un dernier recours jamais atteint. Elle est produite par
# `scripts/prerender.mjs`, qui la rend depuis un chemin inexistant et l'écrit à
# la racine sous ce nom.
ErrorDocument 404 /404.html
